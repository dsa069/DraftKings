// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/java
{
  "name": "API-Spring",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "installMaven": "true",
      "mavenVersion": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  // Ports are already defined in docker-compose.yml
  // "forwardPorts": [8080, 5432],
  // Use 'postCreateCommand' to run commands after the container is created.
  "postCreateCommand": "cd /workspace/api-spring && java -version && mvn --version",
  // Configure tool-specific properties.
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.extension-pack-for-java",
        "pivotal.vscode-spring-boot",
        "vscjava.vscode-maven",
        "github.copilot",
        "github.copilot-chat",
        "cweijan.vscode-postgresql-client2"
      ],
      "settings": {
        "java.configuration.updateBuildConfiguration": "automatic",
        "editor.formatOnSave": true,
        "vscode-postgresql-client.connections": [
          {
            "name": "DraftKings Local",
            "type": "PostgreSQL",
            "host": "postgresql", // Nombre del servicio en Docker
            "port": 5432,
            "user": "postgres",
            "password": "postgres",
            "database": "draftkings",
            "group": "DraftKings"
          }
        ]
      }
    }
  },
  // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
  "remoteUser": "root"
}